{
  "name": "@story-map/react-story-map",
  "version": "0.2.1",
  "description": "React and Leaflet renderer for the StoryMap v1 config format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kywk/story-map.git",
    "directory": "packages/react-story-map"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@story-map/story-map-core": "workspace:*",
    "leaflet": "^1.9.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
