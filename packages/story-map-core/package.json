  "description": "Framework-agnostic schema, parser, and helpers for StoryMap v1.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kywk/story-map.git",
    "directory": "packages/story-map-core"
  },
  "publishConfig": {
