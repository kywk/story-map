{
  "name": "@story-map/remark-story-map",
  "version": "0.5.0",
  "description": "Remark transformer and browser client for publishing StoryMap blocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kywk/story-map.git",
    "directory": "packages/remark-story-map"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@story-map/react-story-map": "workspace:*",
    "@story-map/story-map-core": "workspace:*",
    "gray-matter": "^4.0.3",
    "unist-util-visit": "^5.1.0",
    "leaflet": "^1.9.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
