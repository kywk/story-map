{
  "name": "story-map",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "release:check": "node scripts/release-npm.mjs",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "node --test scripts/release-npm.test.mjs scripts/obsidian-release-stub.test.mjs && pnpm -r --if-present test",
    "clean": "pnpm -r run --if-present clean",
    "dev:obsidian": "pnpm --filter @story-map/story-map-core build && pnpm --filter @story-map/react-story-map build && pnpm --filter @story-map/obsidian-story-map dev"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
